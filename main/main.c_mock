#include <stdio.h>
#include <string.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/uart.h"
#include "esp_log.h"

static const char *TAG = "MOCK_INVERTER";

/* Adjust UART pins to match target wiring on the mock board */
#define MOCK_UART_NUM        UART_NUM_1
#define MOCK_TX_PIN          CONFIG_C3WB_TTL_TX_PIN
#define MOCK_RX_PIN          CONFIG_C3WB_TTL_RX_PIN
#define BUF_SIZE             512

/**
 * @brief Calculate CRC-16/XMODEM (Poly 0x1021, Init 0x0000)
 */
static uint16_t calc_crc16(const char *data, size_t len) {
    uint16_t crc = 0x0000;
    for (size_t i = 0; i < len; i++) {
        crc ^= ((uint16_t)data[i] << 8);
        for (int j = 0; j < 8; j++) {
            if (crc & 0x8000) {
                crc = (crc << 1) ^ 0x1021;
            } else {
                crc = crc << 1;
            }
        }
    }
    return crc;
}

/**
 * @brief Send PI18 response payload with appended 2-byte CRC + '\r'
 */
static void send_pi18_response(const char *payload) {
    size_t len = strlen(payload);
    uint16_t crc = calc_crc16(payload, len);
    uint8_t crc_hi = (crc >> 8) & 0xFF;
    uint8_t crc_lo = crc & 0xFF;

    /* Transmit ASCII payload */
    uart_write_bytes(MOCK_UART_NUM, payload, len);
    /* Transmit 2-byte binary CRC */
    uart_write_bytes(MOCK_UART_NUM, (const char *)&crc_hi, 1);
    uart_write_bytes(MOCK_UART_NUM, (const char *)&crc_lo, 1);
    /* Transmit Carriage Return delimiter */
    uart_write_bytes(MOCK_UART_NUM, "\r", 1);

    ESP_LOGI(TAG, "Sent response for %.*s [CRC: 0x%04X]", (int)(len > 10 ? 10 : len), payload, crc);
}

/**
 * @brief Match query command and trigger matching telemetry or ACK/NACK frame
 */
static void process_incoming_command(char *cmd) {
    size_t len = strlen(cmd);
    while (len > 0 && (cmd[len - 1] == '\r' || cmd[len - 1] == '\n')) {
        cmd[--len] = '\0';
    }
    ESP_LOGI(TAG, "Received command: %s", cmd);

    /* Standard Query Responses */
    if (strstr(cmd, "^P005GS") != NULL) {
        send_pi18_response("^D1062300,500,2300,500,0500,0450,010,512,512,000,000,010,085,042,038,000,0600,0000,1200,0000,0,2,1,1,1,2,0,0");
    } else if (strstr(cmd, "^P007PIRI") != NULL) {
        send_pi18_response("^D0852300,217,2300,500,217,5000,5000,480,460,540,400,564,540,2,60,80,1,1,0,1,0,0,0,1,1");
    } else if (strstr(cmd, "^P005ET") != NULL) {
        send_pi18_response("^D01100012345");
    } else if (strstr(cmd, "^P006MOD") != NULL) {
        send_pi18_response("^D005B");
    } else if (strstr(cmd, "^P005ID") != NULL) {
        send_pi18_response("^D0189632123456789000");
    } else if (strstr(cmd, "^P007PRI0") != NULL) {
        send_pi18_response("^D0391,14,96321234567890000000,0,080,60,0");
    } else if (strstr(cmd, "^P007PGS0") != NULL) {
        send_pi18_response("^D1131,3,00,2300,500,2300,500,1200,1150,2400,2300,024,024,524,000,025,050,085,1500,0000,1125,0000,2,1,1,1,2,0,042");
    
    /* Exemplified Setting Command Response (^S008V2020) */
    } else if (strstr(cmd, "^S008V2020") != NULL) {
        /* Return standard PI18 ACK (^1) */
        send_pi18_response("^1");
    
    /* Generic Setting Command Handler (Catch-all for any other ^S... commands) */
    } else if (cmd[0] == '^' && cmd[1] == 'S') {
        /* Return standard PI18 ACK (^1) for mock testing */
        send_pi18_response("^1");

    } else {
        /* Return standard PI18 NACK (^0) for unrecognized commands */
        ESP_LOGW(TAG, "Unknown command received: %s. Responding with NACK.", cmd);
        send_pi18_response("^0");
    }
}

/**
 * @brief FreeRTOS Task: Listens on UART RX and parses incoming CR-terminated strings
 */
static void mock_inverter_task(void *pvParameters) {
    uint8_t rx_buf[BUF_SIZE];
    char line_buf[BUF_SIZE];
    size_t line_idx = 0;

    while (1) {
        int length = uart_read_bytes(MOCK_UART_NUM, rx_buf, sizeof(rx_buf) - 1, pdMS_TO_TICKS(50));
        
        for (int i = 0; i < length; i++) {
            char c = (char)rx_buf[i];

            if (c == '\r' || c == '\n') {
                if (line_idx > 0) {
                    line_buf[line_idx] = '\0';
                    process_incoming_command(line_buf);
                    line_idx = 0;
                }
            } else if (line_idx < sizeof(line_buf) - 1) {
                line_buf[line_idx++] = c;
            }
        }
    }
}

void app_main(void) {
    uart_config_t uart_config = {
        .baud_rate = 2400,
        .data_bits = UART_DATA_8_BITS,
        .parity    = UART_PARITY_DISABLE,
        .stop_bits = UART_STOP_BITS_1,
        .flow_ctrl = UART_HW_FLOWCTRL_DISABLE,
        .source_clk = UART_SCLK_DEFAULT,
    };

    ESP_ERROR_CHECK(uart_driver_install(MOCK_UART_NUM, BUF_SIZE * 2, 0, 0, NULL, 0));
    ESP_ERROR_CHECK(uart_param_config(MOCK_UART_NUM, &uart_config));
    ESP_ERROR_CHECK(uart_set_pin(MOCK_UART_NUM, MOCK_TX_PIN, MOCK_RX_PIN, UART_PIN_NO_CHANGE, UART_PIN_NO_CHANGE));

    ESP_LOGI(TAG, "Mock Inverter Firmware Started at 2400 8N1");

    xTaskCreate(mock_inverter_task, "mock_inv_task", 3072, NULL, 5, NULL);
}